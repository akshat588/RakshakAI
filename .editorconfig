# RakshakAI v2.0 EditorConfig
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,svg,ico,pdf}]
insert_final_newline = false
trim_trailing_whitespace = false