# =====================================================
# RakshakAI v2.0 - Environment Variables Template
# =====================================================

# -------------------------
# Flask
# -------------------------
FLASK_APP=04_Backend_Development/app.py
FLASK_ENV=development
SECRET_KEY=CHANGE_ME

# -------------------------
# Application
# -------------------------
APP_NAME=RakshakAI
APP_VERSION=2.0.0

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=INFO

# -------------------------
# AI Models
# -------------------------
MODEL_DIRECTORY=03_AI_Model_Development/saved_models

# -------------------------
# Scan History
# -------------------------
HISTORY_DIRECTORY=04_Backend_Development/data

# -------------------------
# WhatsApp Cloud API (Phase 2)
# -------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# -------------------------
# VirusTotal (Phase 8)
# -------------------------
VIRUSTOTAL_API_KEY=

# -------------------------
# AbuseIPDB (Phase 8)
# -------------------------
ABUSEIPDB_API_KEY=

# -------------------------
# OpenAI / Future AI Assistant
# -------------------------
OPENAI_API_KEY=

# -------------------------
# Google Gemini (Optional)
# -------------------------
GEMINI_API_KEY=

# -------------------------
# PostgreSQL (Future)
# -------------------------
DATABASE_URL=

# -------------------------
# ChromaDB / Vector DB
# -------------------------
VECTOR_DB_PATH=./vector_db

# -------------------------
# Playwright
# -------------------------
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5000

# -------------------------
# Security
# -------------------------
ENABLE_RATE_LIMITING=false
ENABLE_DEBUG=false